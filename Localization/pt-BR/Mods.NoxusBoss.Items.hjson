TheBookOfShaders: {
	 DisplayName: O Livro dos Shaders
	 ObtainmentHint: "[c/F79BC6:Vou tentar encontrar esse por conta própria.]"
	 Tooltip:
		'''
		Uma leitura informativa sobre a criação de shaders e arte gerada programaticamente.

Sete páginas são dedicadas a divagações sobre a sacralidade da pixelização.
A última página enfatiza a importância de garantir que esses efeitos sejam otimizados e tenham o máximo desempenho.
		''' 
}

UnfinishedColoringBook: {
	 DisplayName: Livro de Colorir Inacabado
	 ObtainmentHint: "[c/F79BC6:Este livro pode ser encontrado ocasionalmente perto do meu acampamento.]"
